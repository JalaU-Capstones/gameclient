# Base URL of the backend HTTP API.
# - In development, leave empty so the Vite proxy at /api and /health forwards to localhost:8080.
# - In production, set this to the public backend URL (e.g. https://gameapi.onrender.com).
PUBLIC_API_BASE=

# Base URL of the backend WebSocket server.
# - In development, leave empty to derive from window.location (the Vite proxy handles WS upgrades).
# - In production, set this to the backend URL (e.g. https://gameapi.onrender.com).
PUBLIC_WS_BASE=

# Request timeout in milliseconds. Default 15000.
PUBLIC_REQUEST_TIMEOUT_MS=15000
