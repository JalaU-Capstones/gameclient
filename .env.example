# Base URL of the backend HTTP API.
# - In development, leave empty so the Vite proxy at /api and /health forwards to localhost:8080.
# - In production, set this to the public backend URL (e.g. https://gameapi.onrender.com).
PUBLIC_API_BASE=

# Base URL of the backend WebSocket server.
# - In development, leave empty to derive from window.location (the Vite proxy handles WS upgrades).
# - In production, set this to the backend URL (e.g. https://gameapi.onrender.com).
PUBLIC_WS_BASE=

# Request timeout in milliseconds. Default 15000.
PUBLIC_REQUEST_TIMEOUT_MS=15000

# --- Docker-specific overrides ---
# These variables are ONLY used by docker-compose.yml. The values above
# (PUBLIC_API_BASE, PUBLIC_WS_BASE) are for Vite dev and are NOT passed to
# the container.
#
# Defaults (when unset): http://localhost:8080 for both.
#
# To test the Docker build against the deployed backend:
#   DOCKER_PUBLIC_API_BASE=https://gameapi-9vos.onrender.com docker compose up --build
#
# To test against a backend running on the host:
#   DOCKER_PUBLIC_API_BASE=http://host.docker.internal:8080 docker compose up --build
# (On Linux, you may need to add: --add-host=host.docker.internal:host-gateway)
DOCKER_PUBLIC_API_BASE=
DOCKER_PUBLIC_WS_BASE=
